{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/paper", "destination": "/api/paper" },
    { "source": "/assets/made-easy-dummy.js", "destination": "/api/dummy" },
    { "source": "/assets/progress.js", "destination": "/api/progress" },
    { "source": "/assets/calculator.js", "destination": "/api/calculator" },
    { "source": "/assets/calculator.css", "destination": "/api/calc-css" },
    { "source": "/assets/calculator-icon.png", "destination": "/api/calc-icon" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(index.html|paper.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
